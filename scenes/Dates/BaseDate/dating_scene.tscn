[sub_resource type="GDScript" id="GDScript_4d5c8"]
script/source = "#player_panel.gd
extends Panel

@onready var money_label = $MoneyLabel
@onready var stats_panel = $StatsPanel

var player: PlayerCharacter

func _ready():
	custom_minimum_size = Vector2(200, 600)
	position = Vector2(20, 20)

	var style = StyleBoxFlat.new()
	style.bg_color = Color(0.2, 0.2, 0.2, 0.8)
	add_theme_stylebox_override(\"panel\", style)

	# Configure child nodes
	money_label.text = \"Money: $100\"
	money_label.position = Vector2(10, 10)
	money_label.size = Vector2(180, 30)

	stats_panel.position = Vector2(10, 260)
	stats_panel.size = Vector2(350, 300)
	stats_panel.bbcode_enabled = true

func setup(player_character: PlayerCharacter):
	player = player_character
	update_display()
	
func update_display():
	if not player:
		return

	# Update money display
	money_label.text = \"Money: $100\"

	# Skills section - eventually these would come from player
	var skill_text = \"[b]SKILLS:[/b]\\n\"
	var skills = player.skills
	for skill_name in skills:
		skill_text += \"%s: %d\\n\" % [skill_name, skills[skill_name]]

	# Update the stats panel text
	stats_panel.text = skill_text

func update_skills():
	update_display()
"

[sub_resource type="GDScript" id="GDScript_w5d1a"]
script/source = "extends ProgressBar

func _ready():
	# Basic settings
	min_value = 0
	max_value = 100
	custom_minimum_size = Vector2(200, 30)
	position = Vector2(500, 20)

	# Style
	var style = StyleBoxFlat.new()
	style.bg_color = Color(\"#333333\")  # Dark background
	add_theme_stylebox_override(\"background\", style)

	var fill_style = StyleBoxFlat.new()
	fill_style.bg_color = Color(\"#4CAF50\")  # Green fill
	add_theme_stylebox_override(\"fill\", fill_style)

func update_compatibility(value: float):
	self.value = value * 100  # Convert 0-1 to percentage
	modulate = Color.GREEN.lerp(Color.RED, 1 - value)  # Color changes with value

func _update_position():
	var screen_center_x = get_viewport_rect().size.x / 2
	position = Vector2(screen_center_x - custom_minimum_size.x / 3, 20)

func _process(delta: float) -> void:
	_update_position()
"

