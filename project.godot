; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="speed dating"
run/main_scene="uid://ckpg8pvesqt83"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

PlayerManager="*res://scripts/managers/player_manager.gd"
MusicManager="*res://scripts/managers/music_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=3000
window/size/viewport_height=1700
window/size/resizable=false

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/split_ends/m1_test.dialogue", "res://dialogue/split_ends/m2_test.dialogue")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
